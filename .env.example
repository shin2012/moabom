# Copy to .env and fill in. Never commit .env.

# Login for the web UI and the app
MOABOM_USER=
MOABOM_PASS=

# Optional static key for iOS Shortcuts / scripts (header X-API-Key). Leave empty to disable.
MOABOM_API_KEY=

# Optional: X web-client bearer token for auto-like + account status checks. Leave empty to disable.
MOABOM_X_BEARER=

# Host paths used by docker-compose
MOABOM_PORT=8900
MOABOM_LIBRARY_HOST=./library
MOABOM_CERT_DIR=./certs
# If your cert files are not named key.pem / cert.pem:
# MOABOM_TLS_KEY=/certs/your.key
# MOABOM_TLS_CERT=/certs/fullchain.cer

# Folder names for unclassified items (defaults shown)
# MOABOM_WATCH_DIR=자동감시
# MOABOM_LIKES_DIR=좋아요
# MOABOM_UNSORTED_DIR=미분류
# Extra legacy folders that should be treated as "watched account" folders (comma separated)
# MOABOM_LEGACY_WATCH_DIRS=
